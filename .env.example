DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Better Auth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-a-32-byte-random-string
# In production set this to your deployed origin, e.g. https://gym-track.vercel.app
BETTER_AUTH_URL=http://localhost:3000
